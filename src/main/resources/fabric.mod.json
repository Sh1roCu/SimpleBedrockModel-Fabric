{
  "schemaVersion": 1,
  "id": "simplebedrockmodel",
  "version": "${version}",
  "name": "SimpleBedrockModel",
  "description": "SimpleBedrockModel Unofficial Fabric port",
  "authors": [
    "Sh1roCu"
  ],
  "contact": {},
  "license": "LGPL-3.0",
  "environment": "*",
  "entrypoints": {
    "client": [
      "cn.sh1rocu.simplebedrockmodel.client.SimpleBedrockModelClient"
    ],
    "main": [
      "cn.sh1rocu.simplebedrockmodel.SimpleBedrockModel"
    ]
  },
  "mixins": [
    "simplebedrockmodel.mixins.json",
    "simplebedrockmodel.fabric.mixins.json"
  ],
  "accessWidener": "simplebedrockmodel.accesswidener",
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric": "*",
    "minecraft": "${minecraft_version}"
  }
}
